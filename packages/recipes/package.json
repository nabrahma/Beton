{
  "name": "@beton-ui/recipes",
  "version": "0.1.0",
  "description": "Framework-agnostic styling recipes for Béton, built with tailwind-variants.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabrahma/Beton.git",
    "directory": "packages/recipes"
  },
  "homepage": "https://beton.dev",
  "keywords": [
    "beton",
    "neobrutalism",
    "tailwind-variants",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "@types/node": "^22.19.0"
  }
}
